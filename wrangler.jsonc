{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "resto-pi",
	"pages_build_output_dir": ".frame-master/build",
	"compatibility_date": "2026-02-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Non-secret public/build vars only.
	// Required secret: AUTH_SECRET via `wrangler pages secret put AUTH_SECRET`
	// (or local `.env`). Never commit secrets. Do not add a `secrets` key.
	// Replace KV / D1 placeholders with real Cloudflare resource IDs before deploy.
	"vars": {
		"BUN_VERSION": "1.3.13",
		"SKIP_DEPENDENCY_INSTALL": "true",
		"PUBLIC_AUTH_CLIENT_ID": "__resto_pi__",
		"PUBLIC_AUTH_ISSUER": "https://auth.example.com",
		"PUBLIC_AUTH_REDIRECT_URI": "http://localhost:3000/callback"
	},
	"kv_namespaces": [
		{
			"binding": "DYNAMIC_PAGE_KV",
			"id": "<kv-binding-id>"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "resto-pi",
			"database_id": "00000000-0000-0000-0000-000000000001",
			"migrations_dir": "drizzle"
		}
	]
}