# Copy to `.env` for local development.
# Frame Master proxies to Wrangler — WRANGLER_PORT must match wrangler pages/dev.

NODE_ENV=development
WRANGLER_PORT=8787

# ── Client-injected (PUBLIC_*) ──────────────────────────────────────────────
PUBLIC_AUTH_CLIENT_ID=__resto_pi__
PUBLIC_AUTH_ISSUER=https://auth.example.com
PUBLIC_AUTH_REDIRECT_URI=http://localhost:3000/callback

# ── Server-only (never use PUBLIC_ prefix) ──────────────────────────────────
# Prefer Wrangler secrets in production: `wrangler pages secret put AUTH_SECRET`
AUTH_SECRET=

# Colossal / UEAT POSIPAPI (local scripts only — never PUBLIC_)
COLOSSAL_API_KEY=
COLOSSAL_BASE_URL=https://pouletfritideal03.colossalepos.com
COLOSSAL_LOCATION_ID=
